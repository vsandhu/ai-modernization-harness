{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ValidationReport",
  "type": "object",
  "required": [
    "validation",
    "result"
  ],
  "properties": {
    "validation": {
      "type": "object"
    },
    "result": {
      "enum": [
        "PASS",
        "FAIL",
        "CONDITIONAL_PASS"
      ]
    }
  }
}